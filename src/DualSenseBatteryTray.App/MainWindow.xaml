<Window x:Class="DualSenseBatteryTray.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DualSense Battery"
        Width="360"
        Height="230"
        MinWidth="360"
        MinHeight="230"
        MaxWidth="360"
        MaxHeight="230"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo />
    </Window.TaskbarItemInfo>
    <Border Padding="24">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Device" FontWeight="SemiBold" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding DeviceName}" />
            <TextBlock Grid.Row="1" Text="Connection" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ConnectionType}" />
            <TextBlock Grid.Row="2" Text="Battery" FontWeight="SemiBold" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Percentage}" />
            <TextBlock Grid.Row="3" Text="State" FontWeight="SemiBold" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding ChargeState}" />
        </Grid>
    </Border>
</Window>
